PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change_this_to_a_long_random_secret

# SMTP for "Email Results". Without all three of HOST/USER/PASS the feature reports
# "email is not configured" instead of failing; the button also disables when a student has no email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=exams@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=SAVAD Exams <exams@example.com>
# SMTP_SECURE=true   # optional; defaults to true only on port 465
